model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Orders","Dim_Product","DAX Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Orders
ref table Dim_Date
ref table Dim_Customer
ref table Dim_Product
ref table 'DAX Measures'

ref cultureInfo en-US

