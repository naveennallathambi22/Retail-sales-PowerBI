	measure 'Total Discount' =
			
			SUM(Orders[Discount])
		lineageTag: 73d169f4-0dd5-402a-b7d9-bc8a5cb9a0bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
		lineageTag: b2c2ead9-d0b2-4e39-a013-3a96929db5d7

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Top Category' =
			
			VAR CategoryTable =
			    ADDCOLUMNS(
			        ALLSELECTED(Orders[Category]),
			        "@Sales", [Total Sales]
			    )
			VAR TopCategory =
			    TOPN(
			        1,
			        CategoryTable,
			        [@Sales], DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopCategory,
			        Orders[Category],
			        ""
			    )
		lineageTag: 3fabecc4-19e8-4f05-bbfa-248fb4679f63

	measure 'Discount %' =
			
			DIVIDE(
			    SUMX(
			        Orders,
			        Orders[Sales] * Orders[Discount]
			    ),
			    [Total Sales],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e54f1957-64dd-49ef-b199-2b2ffd3f7f9a

	measure 'Sales PY' =
			
			CALCULATE([Total Sales], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		lineageTag: cc62ba98-7037-47c9-b4b6-b05d653776dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit PY' =
			
			CALCULATE([Total Profit], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		lineageTag: 3ce91513-06b1-4c72-bb59-9bc4f95fd35b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit YoY %' =
			
			DIVIDE([Total Profit] - [Profit PY], [Profit PY], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fcaeb374-3a90-4e17-9b99-653b779d51d4

	measure 'Sales YoY %' = ```
			
			DIVIDE([Total Sales] - [Sales PY], [Sales PY], 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5429fefd-a4fa-486d-a5ad-c127f853e9e8

	measure 'Best Performing Category' =
			
			CALCULATE(
			    SELECTEDVALUE(Dim_Product[Category]),
			    TOPN(1, ALL(Dim_Product[Category]), [Total Profit])
			)
		lineageTag: d0fce6ac-cca9-49a9-8c25-96df5107ef0f

	measure 'Worst Margin Sub-Category KPI' =
			
			VAR SubCatTable =
			    ADDCOLUMNS(
			        VALUES(Dim_Product[Sub-Category]),
			        "@Margin", [Margin %]
			    )
			VAR WorstSubCat =
			    TOPN(
			        1,
			        SubCatTable,
			        [@Margin], ASC
			    )
			VAR SubCatName =
			    MAXX(WorstSubCat, Dim_Product[Sub-Category])
			VAR MarginValue =
			    MAXX(WorstSubCat, [@Margin])
			RETURN
			    SubCatName & " (" & FORMAT(MarginValue, "0.00%") & ")"
		lineageTag: cb9f99f7-429d-4748-93f5-540f0d793565

	measure 'Worst Margin Category KPI' =
			
			VAR CategoryTable =
			    ADDCOLUMNS(
			        VALUES(Dim_Product[Category]),
			        "@Margin", [Margin %]
			    )
			VAR WorstCategory =
			    TOPN(
			        1,
			        CategoryTable,
			        [@Margin], ASC
			    )
			VAR CategoryName =
			    MAXX(WorstCategory, Dim_Product[Category])
			VAR MarginValue =
			    MAXX(WorstCategory, [@Margin])
			RETURN
			    CategoryName & " (" & FORMAT(MarginValue, "0.00%") & ")"
		lineageTag: 716a3c68-3115-4a17-bc98-efb564ecff9b

	measure 'Blank Product Sales' =
			
			CALCULATE(
			    [Total Sales],
			    ISBLANK(Orders[Product ID])
			)
		lineageTag: 112f9fb3-9fc5-4004-bc7a-c26c1c7bfdc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Blank Product Rows' =
			
			CALCULATE(
			    COUNTROWS(Orders),
			    ISBLANK(Orders[Product ID])
			)
		formatString: 0
		lineageTag: ea87c6a1-56e5-4bff-a312-6b859fa042eb

	measure 'Unmatched Product Sales' =
			
			VAR FactProducts =
			    FILTER(
			        VALUES(Orders[Product ID]),
			        NOT ISBLANK(Orders[Product ID])
			    )
			VAR DimProducts =
			    FILTER(
			        VALUES(Dim_Product[Product ID]),
			        NOT ISBLANK(Dim_Product[Product ID])
			    )
			VAR UnmatchedProducts =
			    EXCEPT(
			        FactProducts,
			        DimProducts
			    )
			RETURN
			    CALCULATE(
			        [Total Sales],
			        TREATAS(
			            UnmatchedProducts,
			            Orders[Product ID]
			        )
			    )
		lineageTag: 4e795dc3-dc97-4c31-bf1a-205c95b47d50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unmatched Product Count' =
			
			VAR FactProducts =
			    FILTER(
			        VALUES(Orders[Product ID]),
			        NOT ISBLANK(Orders[Product ID])
			    )
			VAR DimProducts =
			    FILTER(
			        VALUES(Dim_Product[Product ID]),
			        NOT ISBLANK(Dim_Product[Product ID])
			    )
			RETURN
			    COUNTROWS(
			        EXCEPT(
			            FactProducts,
			            DimProducts
			        )
			    )
		formatString: 0
		lineageTag: f6a06123-fe17-4dd0-af54-1630b6bc6d84

	measure 'Total Countries' =
			
			CALCULATE(
			    DISTINCTCOUNT(Orders[Country]),
			    Orders[Country] <> BLANK()
			)
		formatString: 0
		lineageTag: e6978c36-8adb-4eea-9d2e-fb9c112c16be

	measure 'Top Region' =
			
			VAR RegionTable =
			    ADDCOLUMNS(
			        ALLSELECTED(Orders[Region]),
			        "@Sales", [Total Sales]
			    )
			VAR TopRegion =
			    TOPN(
			        1,
			        RegionTable,
			        [@Sales], DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopRegion,
			        Orders[Region],
			        ""
			    )
		lineageTag: 0a024277-eb6c-441d-9918-b4cd13ee5b61

	measure 'Top Market' =
			
			VAR MarketTable =
			    ADDCOLUMNS(
			        ALLSELECTED(Orders[Market]),
			        "@Sales", [Total Sales]
			    )
			VAR TopMarket =
			    TOPN(
			        1,
			        MarketTable,
			        [@Sales], DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopMarket,
			        Orders[Market],
			        ""
			    )
		lineageTag: 1e5b591b-4631-43e0-9349-cdb418fc57db

	measure 'Forecasted Sales' =
			
			VAR RecentPeriod = DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -6, MONTH)
			VAR RecentSales = CALCULATE([Total Sales], RecentPeriod)
			VAR PYPeriod = DATEADD(RecentPeriod, -1, YEAR)
			VAR RecentSalesPY = CALCULATE([Total Sales], PYPeriod)
			VAR GrowthRate = DIVIDE(RecentSales - RecentSalesPY, RecentSalesPY, 0)
			RETURN
			    RecentSales + (RecentSales * GrowthRate)
		lineageTag: 4b91ac58-ff78-4454-a3f3-f67ab76347e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecasted Profit' =
			
			VAR RecentPeriod = DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -6, MONTH)
			VAR RecentProfit = CALCULATE([Total Profit], RecentPeriod)
			VAR PYPeriod = DATEADD(RecentPeriod, -1, YEAR)
			VAR RecentProfitPY = CALCULATE([Total Profit], PYPeriod)
			VAR GrowthRate = DIVIDE(RecentProfit - RecentProfitPY, RecentProfitPY, 0)
			RETURN
			    RecentProfit + (RecentProfit * GrowthRate)
		lineageTag: 5362bbce-c013-4971-ac41-1c5488853791

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Growth % (6mo)' =
			
			VAR RecentPeriod = DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -6, MONTH)
			VAR RecentSales = CALCULATE([Total Sales], RecentPeriod)
			VAR PYPeriod = DATEADD(RecentPeriod, -1, YEAR)
			VAR RecentSalesPY = CALCULATE([Total Sales], PYPeriod)
			RETURN
			    DIVIDE(RecentSales - RecentSalesPY, RecentSalesPY, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cf9f7e59-a9ff-41f0-982c-b4895f6453de

