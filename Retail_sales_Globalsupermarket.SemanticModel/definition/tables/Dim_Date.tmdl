	column 'Month Start Date' = DATE(YEAR(Dim_Date[Date]), MONTH(Dim_Date[Date]), 1)
		formatString: Short Date
		lineageTag: 31b8a007-3348-48e4-a614-873566ec64e6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        MIN ( 'Orders'[Order Date] ),
				        MAX ( 'Orders'[Order Date] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM" ),
				    "Month Short", FORMAT ( [Date], "MMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Weekday", FORMAT ( [Date], "dddd" ),
				    "Weekday No", WEEKDAY ( [Date], 2 )
				)

	annotation PBI_Id = 3320e0b5d15445629e392f6dfc41dc70

